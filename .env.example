# Copy to .env (local) or set these in Vercel > Project > Settings > Environment Variables.
# Placeholders only. Never commit real keys.

# Market data (server-side only; never sent to the browser)
ALPHA_VANTAGE_API_KEY=
COINGECKO_DEMO_API_KEY=
TIINGO_API_KEY=
FINNHUB_API_KEY=

# Supabase Auth. Use the publishable (anon) key only. Never put the secret/service-role key here.
SUPABASE_URL=
# example: https://PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Who may load keyed data sources on the public site (provider terms are personal use).
# Comma-separated. Leave empty to block keyed sources for everyone when Supabase is on.
DATA_USER_EMAILS=
DATA_USER_IDS=
